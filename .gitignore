# Patterns deliberately UNANCHORED, so that they bite at every level.
# A leading slash would no longer match in a new subproject.

# Build output
.build/
DerivedData/
*.o
*.hmap
*.dSYM/
*.dSYM.zip

# Per-user Xcode state. The counterpart, xcshareddata, is COMMITTED:
# xcodebuild -scheme fails on the runner when the scheme is not shared.
xcuserdata/
*.xcuserstate
*.xcscmblueprint
*.xccheckout

# SwiftPM's local state, but not its shared schemes under
# .swiftpm/xcode/package.xcworkspace/xcshareddata/
.swiftpm/configuration/
.swiftpm/xcode/xcuserdata/

# Distribution artefacts, produced by the release pipeline and never committed
*.ipa
*.xcarchive/

# Deliberately NOT ignored: Package.resolved. It is the lockfile and belongs in
# the repository, for a library as much as for an app. In the Xcode shape it
# lives inside the bundle, at
# <name>.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/Package.resolved,
# which the xcuserdata rules above leave alone.

# Generated by XcodeGen from project.yml, which is the source of truth. Not
# committed, so a project.pbxproj merge conflict cannot happen in the first
# place. Run `xcodegen generate` after cloning.
*.xcodeproj/

# derivedDataPath used by the documented build command and by CI.
build/

# Generated by XcodeGen from the `info:` and `entitlements:` blocks of
# project.yml. Committing them would create a second source of truth that the
# next `xcodegen generate` silently overwrites. Unanchored, so a target added
# later is covered without anyone remembering this file.
Info.plist
*.entitlements
